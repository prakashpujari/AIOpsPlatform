# ─────────────────────────────────────────────
# Environment Configuration — copy to .env
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_USER=aiops
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=aiops_platform

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=changeme_strong_password

# ── Kafka ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MinIO ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password

# ── Vault ─────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# ── Keycloak ──────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aiops-platform
KEYCLOAK_CLIENT_ID=api-client
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Grafana ───────────────────────────────────
GRAFANA_PASSWORD=admin

# ── AI Gateway ────────────────────────────────
AI_GATEWAY_URL=http://localhost:8001
AI_GATEWAY_API_KEY=changeme

# ── ServiceNow ────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=api_user
SERVICENOW_PASSWORD=changeme

# ── Jira ──────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=api_user@org.com
JIRA_API_TOKEN=changeme
JIRA_PROJECT_KEY=AIOPS

# ── OpenTelemetry ─────────────────────────────
OTEL_SERVICE_NAME=aiops-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Application ───────────────────────────────
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=changeme_32char_secret_key_here_!!
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aiops-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web-client
