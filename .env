# Auto‑generated .env for local development

# AuthJS (NextAuth) secrets
NEXTAUTH_SECRET=super-secret-key-that-is-32+bytes-long
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_TRUST_HOST=true


# Database
POSTGRES_USER=aiops
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=aiops_platform

# Redis
REDIS_PASSWORD=changeme_strong_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# Keycloak (must match docker‑compose defaults)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aiops-platform
KEYCLOAK_CLIENT_ID=web-client
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/aiops-platform

# Grafana
GRAFANA_PASSWORD=admin

# AI Gateway
AI_GATEWAY_URL=http://localhost:8001
AI_GATEWAY_API_KEY=changeme

# ServiceNow (unused locally)
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=api_user
SERVICENOW_PASSWORD=changeme

# Jira (unused locally)
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=api_user@org.com
JIRA_API_TOKEN=changeme
JIRA_PROJECT_KEY=AIOPS

# OpenTelemetry
OTEL_SERVICE_NAME=aiops-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Application
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=changeme_32char_secret_key_here_!!
ALLOWED_ORIGINS=http://localhost:3000

# Frontend (public env vars – prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aiops-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web-client
